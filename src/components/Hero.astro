---
import { Image } from "astro:assets";
import { photos } from "../data/photos";
import Lightbox from "./Lightbox.astro";
---

<section class="min-h-screen pt-32 pb-24 px-6">
  <div class="mx-auto max-w-6xl">
    <!-- Text intro -->
    <div class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-light tracking-[0.15em] uppercase text-stone-900 dark:text-stone-100 animate-fade-up">
        Paul Frederiksen
      </h1>
      <p class="mt-4 text-sm sm:text-base font-light tracking-[0.2em] uppercase text-stone-400 dark:text-stone-500 animate-fade-up delay-200">
        Film Photography
      </p>
    </div>

    <!-- Photo masonry grid -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 [column-fill:_balance]">
      {
        photos.map((photo, i) => (
          <figure
            class="group animate-on-scroll overflow-hidden rounded-sm cursor-pointer mb-5 break-inside-avoid"
            style={`transition-delay: ${i * 100}ms`}
            data-lightbox-trigger={i}
          >
            <div class="overflow-hidden">
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 640, 800, 1024]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                loading={i === 0 ? "eager" : "lazy"}
              />
            </div>
            <figcaption class="mt-3">
              <div class="flex items-baseline justify-between">
                <span class="text-sm font-light text-stone-700 dark:text-stone-300">
                  {photo.title}
                </span>
                {(photo.location || photo.year) && (
                  <span class="text-xs font-light text-stone-400 dark:text-stone-500">
                    {[photo.location, photo.year].filter(Boolean).join(" · ")}
                  </span>
                )}
              </div>
              {(photo.camera || photo.film) && (
                <div class="mt-1 text-xs font-light text-stone-400 dark:text-stone-600">
                  {[photo.camera, photo.film].filter(Boolean).join(" · ")}
                </div>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<Lightbox photos={photos} />
