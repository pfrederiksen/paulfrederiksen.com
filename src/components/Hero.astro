---
import { Image } from "astro:assets";
import { photos } from "../data/photos";
import Lightbox from "./Lightbox.astro";

const featuredPhoto = photos[0];
const galleryPhotos = photos.slice(1);
---

<section class="px-4 pt-24 pb-20 sm:px-6 sm:pt-28">
  <div class="mx-auto max-w-7xl">
    <div
      class="relative min-h-[78svh] overflow-hidden bg-stone-900 text-white shadow-2xl shadow-stone-950/20"
    >
      <Image
        src={featuredPhoto.src}
        alt={featuredPhoto.alt}
        widths={[800, 1280, 1600, 2200]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/30 to-stone-950/10"
      >
      </div>
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10 lg:p-14">
        <div class="max-w-3xl animate-fade-up">
          <p class="text-xs font-medium tracking-[0.22em] uppercase text-stone-200/85">
            Film photography from the desert west
          </p>
          <h1
            class="mt-5 text-5xl font-light uppercase leading-[0.95] tracking-[0.1em] sm:text-7xl lg:text-8xl"
          >
            Paul Frederiksen
          </h1>
          <p class="mt-6 max-w-xl text-base font-light leading-relaxed text-stone-200 sm:text-lg">
            Quiet roads, hard light, desert edges, and the places that happen between
            destinations.
          </p>
        </div>
        <div
          class="mt-10 flex flex-wrap items-end justify-between gap-6 animate-fade-up delay-200"
        >
          <a
            href="#photographs"
            class="inline-flex items-center justify-center border border-white/45 px-5 py-3 text-xs font-medium uppercase tracking-[0.16em] text-white transition hover:border-white hover:bg-white hover:text-stone-950"
          >
            View Photographs
          </a>
          <div class="text-right">
            <p class="text-sm font-light text-stone-100">{featuredPhoto.title}</p>
            <p class="mt-1 text-xs font-light text-stone-300">
              {[featuredPhoto.location, featuredPhoto.year].filter(Boolean).join(" / ")}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div id="photographs" class="pt-20">
      <div class="mb-10 grid gap-6 md:grid-cols-[0.75fr_1.25fr] md:items-end">
        <div class="animate-on-scroll">
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">
            Selected work
          </p>
          <h2
            class="mt-3 text-3xl font-light uppercase tracking-[0.08em] text-stone-900 dark:text-stone-100 sm:text-4xl"
          >
            Photographs
          </h2>
        </div>
        <p
          class="animate-on-scroll max-w-2xl text-sm leading-relaxed text-stone-600 dark:text-stone-400 sm:text-base md:justify-self-end"
        >
          A compact edit of film photographs from highways, desert towns, and the edges
          of Las Vegas.
        </p>
      </div>

      <div class="columns-1 gap-5 [column-fill:_balance] sm:columns-2 lg:columns-3">
        <figure
          class="group animate-on-scroll mb-5 break-inside-avoid cursor-pointer overflow-hidden"
          data-lightbox-trigger={0}
        >
          <div class="overflow-hidden">
            <Image
              src={featuredPhoto.src}
              alt={featuredPhoto.alt}
              widths={[400, 640, 800, 1024]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-sm font-light text-stone-700 dark:text-stone-300">
                {featuredPhoto.title}
              </span>
              {(featuredPhoto.location || featuredPhoto.year) && (
                <span class="text-right text-xs font-light text-stone-400 dark:text-stone-500">
                  {[featuredPhoto.location, featuredPhoto.year].filter(Boolean).join(" / ")}
                </span>
              )}
            </div>
          </figcaption>
        </figure>

        {
          galleryPhotos.map((photo, i) => (
            <figure
              class="group animate-on-scroll mb-5 break-inside-avoid cursor-pointer overflow-hidden"
              style={`transition-delay: ${i * 100}ms`}
              data-lightbox-trigger={i + 1}
            >
              <div class="overflow-hidden">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[400, 640, 800, 1024]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
              <figcaption class="mt-3">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-sm font-light text-stone-700 dark:text-stone-300">
                    {photo.title}
                  </span>
                  {(photo.location || photo.year) && (
                    <span class="text-right text-xs font-light text-stone-400 dark:text-stone-500">
                      {[photo.location, photo.year].filter(Boolean).join(" / ")}
                    </span>
                  )}
                </div>
                {(photo.camera || photo.film) && (
                  <div class="mt-1 text-xs font-light text-stone-400 dark:text-stone-600">
                    {[photo.camera, photo.film].filter(Boolean).join(" / ")}
                  </div>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<Lightbox photos={photos} />
