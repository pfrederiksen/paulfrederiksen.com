---
import { Image } from "astro:assets";
import desertHighway from "../assets/photos/01-desert-highway.jpg";
---

<section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
  <!-- Background photo -->
  <div class="absolute inset-0">
    <Image
      src={desertHighway}
      alt=""
      class="h-full w-full object-cover"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      loading="eager"
    />
    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-stone-950/60 via-stone-950/30 to-stone-950/70 dark:from-stone-950/70 dark:via-stone-950/40 dark:to-stone-950/80"></div>
  </div>

  <!-- Text overlay -->
  <div class="relative z-10 text-center px-6">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-light tracking-[0.15em] uppercase text-white animate-fade-up">
      Paul Frederiksen
    </h1>
    <p class="mt-4 text-sm sm:text-base font-light tracking-[0.2em] uppercase text-stone-300 animate-fade-up delay-200">
      Film Photography
    </p>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#gallery"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 text-white/60 hover:text-white/90 transition-colors animate-fade-in delay-500"
    aria-label="Scroll to gallery"
  >
    <svg class="w-6 h-6 animate-bounce-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>
