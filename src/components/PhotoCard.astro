---
import { Image } from "astro:assets";
import type { Photo } from "../data/photos";

interface Props {
  photo: Photo;
}

const { photo } = Astro.props;
---

<figure class="group overflow-hidden rounded-sm">
  <div class="overflow-hidden">
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[400, 640, 800, 1024]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
    />
  </div>
  <figcaption class="mt-3 flex items-baseline justify-between">
    <span class="text-sm font-light text-stone-700 dark:text-stone-300">
      {photo.title}
    </span>
    {
      (photo.location || photo.year) && (
        <span class="text-xs font-light text-stone-400 dark:text-stone-500">
          {[photo.location, photo.year].filter(Boolean).join(" · ")}
        </span>
      )
    }
  </figcaption>
</figure>
