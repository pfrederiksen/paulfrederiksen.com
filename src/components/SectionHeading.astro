---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12 text-center">
  <h2
    class="text-2xl sm:text-3xl font-light tracking-[0.08em] uppercase text-stone-900 dark:text-stone-100"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-sm font-light text-stone-500 dark:text-stone-400 tracking-wide">
        {subtitle}
      </p>
    )
  }
</div>
