---
import SectionHeading from "./SectionHeading.astro";
import { socials, email } from "../data/socials";
---

<section id="contact" class="py-24 px-6">
  <div class="mx-auto max-w-4xl">
    <div class="animate-on-scroll">
      <SectionHeading title="Connect" />
    </div>

    <div class="animate-on-scroll flex flex-wrap justify-center gap-6 sm:gap-8">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors duration-200"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              set:html={social.icon}
            />
            <span class="text-sm font-light tracking-wide uppercase">
              {social.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="animate-on-scroll mt-12 text-center">
      <a
        href={`mailto:${email}`}
        class="inline-block text-sm font-light tracking-[0.1em] uppercase text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors duration-200 border-b border-stone-300 dark:border-stone-700 pb-0.5 hover:border-stone-900 dark:hover:border-stone-100"
      >
        {email}
      </a>
    </div>
  </div>
</section>
