---
import { Image } from "astro:assets";
import type { Photo } from "../data/photos";

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<!-- Lightbox overlay -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-stone-950/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Photo lightbox"
>
  <!-- Close button -->
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 z-10 p-2 text-stone-400 hover:text-white transition-colors cursor-pointer"
    aria-label="Close lightbox"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Previous button -->
  <button
    id="lightbox-prev"
    class="absolute left-4 top-1/2 -translate-y-1/2 z-10 p-2 text-stone-400 hover:text-white transition-colors cursor-pointer"
    aria-label="Previous photo"
  >
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Next button -->
  <button
    id="lightbox-next"
    class="absolute right-4 top-1/2 -translate-y-1/2 z-10 p-2 text-stone-400 hover:text-white transition-colors cursor-pointer"
    aria-label="Next photo"
  >
    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Image container -->
  <div class="flex flex-col items-center justify-center w-full h-full px-16 py-16">
    {
      photos.map((photo, i) => (
        <div
          class="lightbox-slide hidden flex-col items-center justify-center w-full h-full"
          data-slide={i}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[800, 1280, 1920]}
            sizes="90vw"
            class="max-w-full max-h-[75vh] w-auto h-auto object-contain"
            loading="lazy"
          />
          <div class="mt-4 text-center">
            <p class="text-sm font-light text-stone-300">
              {photo.title}
            </p>
            <p class="mt-1 text-xs font-light text-stone-500">
              {[photo.location, photo.year].filter(Boolean).join(" · ")}
              {(photo.camera || photo.film) && (
                <span>
                  {" — "}
                  {[photo.camera, photo.film].filter(Boolean).join(" · ")}
                </span>
              )}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const slides = lightbox.querySelectorAll<HTMLElement>(".lightbox-slide");
  const total = slides.length;
  let current = 0;

  function show(index: number) {
    current = (index + total) % total;
    slides.forEach((s, i) => {
      s.classList.toggle("hidden", i !== current);
      s.classList.toggle("flex", i === current);
    });
  }

  function open(index: number) {
    show(index);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  // Trigger from grid
  document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((el) => {
    el.addEventListener("click", () => {
      open(parseInt(el.dataset.lightboxTrigger!, 10));
    });
  });

  // Controls
  document.getElementById("lightbox-close")!.addEventListener("click", close);
  document.getElementById("lightbox-prev")!.addEventListener("click", () => show(current - 1));
  document.getElementById("lightbox-next")!.addEventListener("click", () => show(current + 1));

  // Click backdrop to close
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  // Keyboard
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
</script>
