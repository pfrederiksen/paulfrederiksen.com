---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "ReciproMeter Support";
const description =
  "Support information for ReciproMeter, the iPhone film reciprocity and metering app.";
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen px-6 pt-32 pb-24 bg-stone-50 dark:bg-stone-950">
    <div class="mx-auto max-w-4xl">
      <a
        href="/reciprometer"
        class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.16em] uppercase text-stone-500 transition hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
      >
        <span aria-hidden="true">←</span>
        Back to ReciproMeter
      </a>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <section class="rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900">
          <p class="text-xs font-medium tracking-[0.18em] uppercase text-stone-500 dark:text-stone-400">
            Support
          </p>
          <h1 class="mt-4 text-4xl font-light tracking-[0.06em] uppercase text-stone-900 dark:text-stone-100">
            ReciproMeter Support
          </h1>
          <p class="mt-6 text-sm sm:text-base leading-relaxed text-stone-600 dark:text-stone-400">
            If you need help with ReciproMeter, include as much of the following as possible:
          </p>

          <ul class="mt-6 space-y-3 text-sm sm:text-base text-stone-700 dark:text-stone-300">
            <li>Device model</li>
            <li>iOS version</li>
            <li>ReciproMeter version and build number</li>
            <li>A short description of the issue</li>
            <li>Screenshots if they help explain the problem</li>
          </ul>

          <div class="mt-8 rounded-2xl bg-stone-100/80 p-5 dark:bg-stone-800/70">
            <p class="text-xs font-medium tracking-[0.18em] uppercase text-stone-500 dark:text-stone-400">
              Contact
            </p>
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-stone-700 dark:text-stone-300">
              For support with ReciproMeter, email:
            </p>
            <p class="mt-4 text-sm font-medium text-stone-900 dark:text-stone-100">
              paul@paulfrederiksen.com
            </p>
          </div>
        </section>

        <section class="rounded-[2rem] border border-stone-200 bg-stone-100/80 p-8 dark:border-stone-800 dark:bg-stone-900/70">
          <p class="text-xs font-medium tracking-[0.18em] uppercase text-stone-500 dark:text-stone-400">
            Common topics
          </p>
          <div class="mt-6 space-y-5">
            <div>
              <h2 class="text-lg font-medium text-stone-900 dark:text-stone-100">Camera access</h2>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                Metering requires camera access so ReciproMeter can read exposure metadata.
              </p>
            </div>
            <div>
              <h2 class="text-lg font-medium text-stone-900 dark:text-stone-100">Purchase restore</h2>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                If you already bought lifetime access, use Restore Purchases in the app Settings or paywall.
              </p>
            </div>
            <div>
              <h2 class="text-lg font-medium text-stone-900 dark:text-stone-100">Film data questions</h2>
              <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                ReciproMeter distinguishes official, community, and experimental reciprocity guidance so you can judge confidence clearly.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
